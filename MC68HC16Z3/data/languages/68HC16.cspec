<?xml version="1.0" encoding="UTF-8"?>

<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/compiler_spec.rxg -->

<!-- Generic MC68HC16 (CPU16) compiler spec (language 68HC16:BE:24:default).

     The MC68HC16 has no single ABI (era firmware is typically hand-written
     assembly), so the default __asmcall convention below is a conservative,
     best-effort model: first arg in D / E:D, return in D / E:D, IX as a
     common frame pointer, and the architecturally-sticky bank registers
     (EK/XK/YK/ZK/PK) plus SP/SK preserved across calls. Reassign a
     per-function convention wherever a routine clearly deviates.

     Unlike the JTEC+ preset (68HC16_JTEC.cspec / __pcm_default), this
     default does NOT assume IZ holds a preserved global data pointer; IZ
     is treated as clobbered by a call. If your firmware does dedicate an
     index register to a global base, switch to __pcm_default or define your
     own convention.

     This file defines:
       - C data type sizes and alignment for the CPU16 architecture
       - Stack pointer and return address conventions
       - Default calling convention (parameter passing, return values,
         which registers are preserved vs. trashed across function calls)
     
     Register DEFINITIONS live in 68HC16.slaspec, not here.
     Register UI GROUPING lives in 68HC16.pspec, not here.
     This file only REFERENCES registers by name for calling-convention purposes.
-->

<compiler_spec>

  <!-- ================================================================
       Data Organization
       CPU16: 16-bit data bus, big-endian, 20-bit addresses (3 bytes)
       Natural data sizes for this architecture (era assemblers/compilers):
          char=1, short=2, int=2, long=4, pointer=3 (20-bit addr space) 
       ================================================================ -->
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="2"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="2"/>
    <pointer_size value="3"/>
    <char_size value="1"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
    <long_long_size value="4"/>
    <float_size value="4"/>
    <double_size value="4"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="2"/>
    </size_alignment_map>
  </data_organization>

  <!-- Global address space -->
  <global>
    <range space="ram"/>
  </global>

  <!-- Stack: SP register, grows downward (high-to-low), lives in RAM.
       The CPU16 uses SK:SP for 20-bit stack addressing, but Ghidra
       tracks the 16-bit SP and the extension separately. -->
       
  <stackpointer register="SSP" space="ram" growth="negative"/>

  <!-- Return address: pushed onto stack by BSR/JSR, pulled by RTS.
       The CPU16 stacks PC (return address + 2) at SP+4 and CCR with PK at SP+2. -->
       
  <returnaddress>
    <varnode space="stack" offset="2" size="4"/>
  </returnaddress>

  <!-- ================================================================
       Default Calling Convention: __asmcall (generic HC16)

       A conservative, best-effort model for hand-written CPU16 assembly,
       which has no formal ABI. A reasonable starting point for the
       decompiler, not a guarantee. Reassign a per-function convention
       wherever a routine clearly deviates.

       Parameter passing:
         - First integer/pointer arg in D (1-2 bytes), or the E:D pair for
           32-bit values (E=high word, D=low word).
         - Further args, when stack-passed, are pushed right to left.

       Return values:
         - char/short/int/pointer: D register
         - long/float-width: E:D pair (E=high word, D=low word)

       Register preservation:
         - Clobbered by a call: A, B, D, E, IY, IZ, CCR
         - Preserved across a call: IX (common frame pointer), SP/SK, and
           the architecturally-sticky bank registers (EK, XK, YK, ZK, PK).

       NOTE: IZ is treated as clobbered here. If your firmware dedicates an
       index register to a global data pointer (as JTEC+ does with IZ),
       switch to the __pcm_default convention (or the JTEC language), which
       keeps IZ callee-saved so Z-indexed global accesses survive a call.

       Stack frame:
         - IX commonly serves as the frame pointer.
         - Typical prologue: pshm <regs>; ais #-<size>; tsx
         - stackshift=4: JSR/BSR push PK:PC + CCR = 4 bytes.
         - SK:SP points at the next free word, so on entry the stacked CCR
           (with PK) is at SP+2, the stacked PC at SP+4 and the first stacked
           argument at SP+6; extrapop=4 because RTS pulls both words.
       ================================================================ -->
  <default_proto>
    <prototype name="__asmcall" extrapop="4" stackshift="4">
  <input>
    <!-- First arg: D register for char/short/int/pointer (1-2 bytes) -->
    <pentry minsize="1" maxsize="2">
      <register name="D"/>
    </pentry>
    <!-- First arg: E:D join for long/float-width values (3-4 bytes)
         E=high word (piece1), D=low word (piece2) -->

    <pentry minsize="3" maxsize="4">
      <addr space="join" piece1="E" piece2="D"/>
    </pentry>
    <!-- Remaining args: stack, right-to-left -->
    <pentry minsize="1" maxsize="500" align="2">
      <addr offset="6" space="stack"/>
    </pentry>
  </input>
  <output>
    <!-- Return: D for char/short/int/pointer (1-2 bytes) -->
    <pentry minsize="1" maxsize="2">
      <register name="D"/>
    </pentry>
    <!-- Return: E:D join for long/float (3-4 bytes)
         E=high word, D=low word -->
    <pentry minsize="3" maxsize="4">
      <addr space="join" piece1="E" piece2="D"/>
    </pentry>
  </output>
  <unaffected>
    <register name="SSP"/>
    <register name="SP"/>
    <register name="SK"/>
    <register name="XKIX"/>  <!-- XK:IX as one value (,X addressing reads the composite) -->
    <register name="YK"/>
    <register name="ZK"/>
    <register name="PK"/>
    <register name="EK"/>
  </unaffected>
  <killedbycall>
    <register name="A"/>
    <register name="B"/>
    <register name="D"/>
    <register name="E"/>
    <register name="IY"/>
    <register name="IZ"/>
    <register name="CCR"/>
  </killedbycall>
</prototype>
  </default_proto>

  <!-- ================================================================
       Alternate Calling Conventions

       __pcm_default : the JTEC+ empirical convention, identical to
         __asmcall except IZ is callee-saved (global data pointer). Kept
         here as an option for firmware that dedicates IZ to a global base.
       __table_1d / __table_2d : register-heavy table-interpolation
         routines that take a table pointer in IX plus lookup value(s) in
         A/B. Reusable for any ROM'd lookup-table firmware.

       Assign to specific functions via right-click -> Edit Function
       Signature -> select the convention from the calling convention
       dropdown.
       ================================================================ -->

<!-- IZ-preserving variant (dedicated global data pointer in IZ) -->
<prototype name="__pcm_default" extrapop="4" stackshift="4">
  <input>
    <pentry minsize="1" maxsize="2">
      <register name="D"/>
    </pentry>
    <pentry minsize="3" maxsize="4">
      <addr space="join" piece1="E" piece2="D"/>
    </pentry>
    <pentry minsize="1" maxsize="500" align="2">
      <addr offset="6" space="stack"/>
    </pentry>
  </input>
  <output>
    <pentry minsize="1" maxsize="2">
      <register name="D"/>
    </pentry>
    <pentry minsize="3" maxsize="4">
      <addr space="join" piece1="E" piece2="D"/>
    </pentry>
  </output>
  <unaffected>
    <register name="SSP"/>
    <register name="SP"/>
    <register name="SK"/>
    <register name="XKIX"/>  <!-- XK:IX as one value (,X addressing reads the composite) -->
    <register name="YK"/>
    <register name="ZKIZ"/>  <!-- ZK:IZ, so the composite used by ,Z addressing is preserved as a whole -->
    <register name="PK"/>
    <register name="EK"/>
  </unaffected>
  <killedbycall>
    <register name="A"/>
    <register name="B"/>
    <register name="D"/>
    <register name="E"/>
    <register name="IY"/>
    <register name="CCR"/>
  </killedbycall>
</prototype>


<!-- 1D table lookup: IX=table pointer, A=lookup param -->
<prototype name="__table_1d" extrapop="4" stackshift="4">
  <input>
    <pentry minsize="2" maxsize="2">
      <register name="IX"/>
    </pentry>
    <pentry minsize="1" maxsize="1">
      <register name="A"/>
    </pentry>
  </input>
  <output>
    <pentry minsize="1" maxsize="1">
      <register name="B"/>
    </pentry>
    <pentry minsize="2" maxsize="2">
      <register name="D"/>
    </pentry>
  </output>
  <unaffected>
    <register name="SSP"/>
    <register name="SP"/>
    <register name="SK"/>
    <register name="XKIX"/>  <!-- XK:IX as one value (,X addressing reads the composite) -->
    <register name="YK"/>
    <register name="ZKIZ"/>  <!-- ZK:IZ, so the composite used by ,Z addressing is preserved as a whole -->
    <register name="PK"/>
    <register name="EK"/>
  </unaffected>
  <killedbycall>
    <register name="A"/>
    <register name="B"/>
    <register name="D"/>
    <register name="E"/>
    <register name="IY"/>
    <register name="CCR"/>
  </killedbycall>
</prototype>

<!-- 2D table lookup: IX=table pointer, A=row param, B=column param -->
<prototype name="__table_2d" extrapop="4" stackshift="4">
  <input>
    <pentry minsize="2" maxsize="2">
      <register name="IX"/>
    </pentry>
    <pentry minsize="1" maxsize="1">
      <register name="A"/>
    </pentry>
    <pentry minsize="1" maxsize="1">
      <register name="B"/>
    </pentry>
  </input>
  <output>
    <pentry minsize="1" maxsize="1">
      <register name="A"/>
    </pentry>
    <pentry minsize="2" maxsize="2">
      <register name="E"/>
    </pentry>
  </output>
  <unaffected>
    <register name="SSP"/>
    <register name="SP"/>
    <register name="SK"/>
    <register name="XKIX"/>  <!-- XK:IX as one value (,X addressing reads the composite) -->
    <register name="YK"/>
    <register name="ZKIZ"/>  <!-- ZK:IZ, so the composite used by ,Z addressing is preserved as a whole -->
    <register name="PK"/>
    <register name="EK"/>
  </unaffected>
  <killedbycall>
    <register name="A"/>
    <register name="B"/>
    <register name="D"/>
    <register name="E"/>
    <register name="IY"/>
    <register name="CCR"/>
  </killedbycall>
</prototype>
   
</compiler_spec>
