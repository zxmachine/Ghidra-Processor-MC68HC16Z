# --- PULM: pulls in mask-bit order CCR, K, IZ, IY, IX, E, D (lowest address first) ---
pulmList: "" is regmask=0x00 {  }
pulmList: "CCR" is regmask=0x01 { pull16(CCR); syncPullPK(CCR); }
pulmList: "K" is regmask=0x02 { local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; }
pulmList: "CCR,K" is regmask=0x03 { pull16(CCR); syncPullPK(CCR); local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; }
pulmList: "IZ" is regmask=0x04 { pull16(IZ); }
pulmList: "CCR,IZ" is regmask=0x05 { pull16(CCR); syncPullPK(CCR); pull16(IZ); }
pulmList: "K,IZ" is regmask=0x06 { local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; pull16(IZ); }
pulmList: "CCR,K,IZ" is regmask=0x07 { pull16(CCR); syncPullPK(CCR); local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; pull16(IZ); }
pulmList: "IY" is regmask=0x08 { pull16(IY); }
pulmList: "CCR,IY" is regmask=0x09 { pull16(CCR); syncPullPK(CCR); pull16(IY); }
pulmList: "K,IY" is regmask=0x0A { local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; pull16(IY); }
pulmList: "CCR,K,IY" is regmask=0x0B { pull16(CCR); syncPullPK(CCR); local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; pull16(IY); }
pulmList: "IZ,IY" is regmask=0x0C { pull16(IZ); pull16(IY); }
pulmList: "CCR,IZ,IY" is regmask=0x0D { pull16(CCR); syncPullPK(CCR); pull16(IZ); pull16(IY); }
pulmList: "K,IZ,IY" is regmask=0x0E { local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; pull16(IZ); pull16(IY); }
pulmList: "CCR,K,IZ,IY" is regmask=0x0F { pull16(CCR); syncPullPK(CCR); local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; pull16(IZ); pull16(IY); }
pulmList: "IX" is regmask=0x10 { pull16(IX); }
pulmList: "CCR,IX" is regmask=0x11 { pull16(CCR); syncPullPK(CCR); pull16(IX); }
pulmList: "K,IX" is regmask=0x12 { local un:2; pull16(un); EK=un[12,4]; XK=un[8,4]; YK=un[4,4]; ZK=un[0,4]; pull16(IX); }
